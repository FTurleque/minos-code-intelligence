function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := False;
  if (PageID = DataRootPage.ID) or (PageID = McpNamePage.ID) or (PageID = StoragePage.ID) or
     (PageID = SemanticPage.ID) then
    Result := not AdvancedSetupSelected()
  else if PageID = PostgresPage.ID then
    Result := (not AdvancedSetupSelected()) or (not PostgreSqlSelected()) or DockerMcpSelected()
  else if PageID = OllamaPage.ID then
    Result := (not AdvancedSetupSelected()) or (not OllamaSelected())
  else if PageID = McpClientsPage.ID then
    Result := NoMcpSelected()
  else if PageID = DockerProjectsPage.ID then
    Result := not DockerMcpSelected();
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  if CurPageID = OllamaPage.ID then UpdateOllamaPageMode;
  if CurPageID = SummaryPage.ID then UpdateSummary;
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  Dimensions: Integer;
begin
  Result := True;

  if (CurPageID = DataRootPage.ID) and AdvancedSetupSelected() then
  begin
    if (DataRootPage.Values[0] = '') or (not IsAbsoluteWindowsPath(DataRootPage.Values[0])) then
    begin MsgBox('Choisissez un chemin absolu valide pour MINOS_HOME.', mbError, MB_OK); Result := False; exit; end;
  end;

  if (CurPageID = McpNamePage.ID) and AdvancedSetupSelected() then
  begin
    if not IsSafeMcpName(McpNamePage.Values[0]) then
    begin MsgBox('Le nom MCP doit commencer par une lettre et contenir uniquement lettres, chiffres, _ ou - (64 caractères maximum).', mbError, MB_OK); Result := False; exit; end;
  end;

  if (CurPageID = PostgresPage.ID) and PostgreSqlSelected() and (not DockerMcpSelected()) then
  begin
    if Pos('jdbc:postgresql://', Lowercase(PostgresUrlEdit.Text)) <> 1 then
    begin MsgBox('L''URL PostgreSQL doit commencer par jdbc:postgresql://', mbError, MB_OK); Result := False; exit; end;
    if ContainsUnsafeCommandText(PostgresUrlEdit.Text) then
    begin MsgBox('L''URL PostgreSQL contient un caractère non autorisé.', mbError, MB_OK); Result := False; exit; end;
    if not IsSafeIdentifier(PostgresUserEdit.Text) then
    begin MsgBox('L''utilisateur PostgreSQL doit être un identifiant sûr.', mbError, MB_OK); Result := False; exit; end;
    if PostgresPasswordEdit.Text = '' then
    begin MsgBox('Le mot de passe PostgreSQL est requis.', mbError, MB_OK); Result := False; exit; end;
    if not IsSafeIdentifier(PostgresSchemaEdit.Text) then
    begin MsgBox('Le schéma PostgreSQL doit être un identifiant sûr.', mbError, MB_OK); Result := False; exit; end;
  end;

  if (CurPageID = OllamaPage.ID) and OllamaSelected() then
  begin
    if (OllamaModelEdit.Text = '') or ContainsUnsafeCommandText(OllamaModelEdit.Text) then
    begin MsgBox('Le nom du modèle Ollama est invalide.', mbError, MB_OK); Result := False; exit; end;
    Dimensions := StrToIntDef(OllamaDimensionsEdit.Text, 0);
    if (Dimensions < 32) or (Dimensions > 16384) then
    begin MsgBox('Les dimensions Ollama doivent être comprises entre 32 et 16384.', mbError, MB_OK); Result := False; exit; end;
    if (not DockerMcpSelected()) and ((OllamaEndpointEdit.Text = '') or ContainsUnsafeCommandText(OllamaEndpointEdit.Text)) then
    begin MsgBox('L''endpoint Ollama est invalide.', mbError, MB_OK); Result := False; exit; end;
  end;

  if (CurPageID = McpModePage.ID) and McpBackendSelected() and (not McpPreflightCompleted) then
  begin
    RunMcpPreflight;
    McpPreflightCompleted := True;
  end;

  if CurPageID = McpClientsPage.ID then
  begin
    if McpCodexCli.Checked and McpCodexDesktop.Checked then
    begin
      MsgBox(
        'Codex CLI et Codex Desktop utilisent la même intégration MINOS nommée.' + #13#10 + #13#10 +
        'Sélectionnez un seul mode Codex. Le choix peut être modifié plus tard sans changer le backend MCP.',
        mbError, MB_OK);
      Result := False; exit;
    end;
  end;

  if (CurPageID = DockerProjectsPage.ID) and DockerMcpSelected() then
  begin
    if not DirExists(DockerProjectsPage.Values[0]) then
    begin MsgBox('La racine des projets n''existe pas. Choisissez un dossier existant.', mbError, MB_OK); Result := False; exit; end;
    if (DockerDataRootEdit.Text = '') or (not IsAbsoluteWindowsPath(DockerDataRootEdit.Text)) then
    begin MsgBox('Choisissez un chemin absolu valide pour les données Docker.', mbError, MB_OK); Result := False; exit; end;
    if not IsSafeDockerName(DockerInstanceEdit.Text) then
    begin MsgBox('Le nom de l''instance Docker contient un caractère non autorisé.', mbError, MB_OK); Result := False; exit; end;
    if not DockerReady() then
    begin
      MsgBox(
        'Docker Desktop n''est pas disponible ou son daemon n''est pas démarré.' + #13#10 + #13#10 +
        'Le backend Docker a été explicitement sélectionné : l''installation ne basculera pas silencieusement vers le backend natif.' + #13#10 +
        'Démarrez Docker Desktop puis réessayez, ou revenez en arrière pour sélectionner un autre mode.', mbError, MB_OK);
      Result := False; exit;
    end;
  end;
end;

procedure PromptForUserDataRemoval;
var
  DataRoot: String;
  DockerRoot: String;
  MessageText: String;
begin
  DeleteUserDataOnUninstall := False;
  if IsSmokeBuild() or UninstallSilent() then exit;
  DataRoot := ReadInstallerValue('DataRoot', DefaultDataRoot());
  DockerRoot := ReadInstallerValue('DockerDataRoot', DefaultDockerDataRoot());
  if (not DirExists(DataRoot)) and (not DirExists(DockerRoot)) then exit;
  MessageText :=
    'Supprimer également toutes les données MINOS locales ?' + #13#10 + #13#10 +
    'Données natives / contrôle :' + #13#10 + DataRoot + #13#10 + #13#10 +
    'Données Docker :' + #13#10 + DockerRoot + #13#10 + #13#10 +
    'Oui supprime aussi les volumes PostgreSQL/Ollama gérés par MINOS. Une base PostgreSQL externe n''est jamais supprimée.' + #13#10 + #13#10 +
    'Cette opération est irréversible. Choisissez Non pour conserver les données.';
  DeleteUserDataOnUninstall := MsgBox(MessageText, mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES;
end;

procedure PurgeManagedDockerVolumes;
var
  InstanceName: String;
  ResultCode: Integer;
begin
  if IsSmokeBuild() or (not DeleteUserDataOnUninstall) then exit;
  InstanceName := ReadInstallerValue('DockerInstanceName', 'minos-mcp-prod');
  if not IsSafeDockerName(InstanceName) then exit;
  Exec(ExpandConstant('{cmd}'), '/C docker volume rm "' + InstanceName + '-postgres-data" "' + InstanceName + '-ollama-models" >NUL 2>&1', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
end;

procedure DeleteRootIfPresent(PathValue: String);
begin
  if (PathValue <> '') and DirExists(PathValue) then DelTree(PathValue, True, True, True);
end;

procedure DeleteMinosUserData;
var
  UserDataRoot: String;
  DockerRoot: String;
  DefaultRoot: String;
begin
  if IsSmokeBuild() or (not DeleteUserDataOnUninstall) then exit;
  UserDataRoot := ReadInstallerValue('DataRoot', DefaultDataRoot());
  DockerRoot := ReadInstallerValue('DockerDataRoot', DefaultDockerDataRoot());
  DefaultRoot := ExpandConstant('{localappdata}\MINOS');
  PurgeManagedDockerVolumes;
  if (UserDataRoot <> '') and DirExists(UserDataRoot) then DelTree(UserDataRoot, True, True, True);
  if (CompareText(DockerRoot, UserDataRoot) <> 0) then DeleteRootIfPresent(DockerRoot);
  DeleteRootIfPresent(DefaultRoot);
  RegDeleteKeyIncludingSubkeys(HKCU, InstallerRegistryPath());
end;

function ExtractMinosPayload(): String;
var
  PowerShell: String;
  Parameters: String;
  ResultCode: Integer;
  PayloadZip: String;
  PayloadDir: String;
begin
  Result := '';
  try ExtractTemporaryFile('minos-payload.zip');
  except
    Result := 'Le paquet MINOS n''a pas pu etre extrait de l''installateur.';
    exit;
  end;
  PayloadZip := ExpandConstant('{tmp}\minos-payload.zip');
  PayloadDir := ExpandConstant('{tmp}\minos-payload');
  PowerShell := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  Parameters :=
    '-NoProfile -ExecutionPolicy Bypass -Command "Expand-Archive -LiteralPath ''' + PayloadZip +
    ''' -DestinationPath ''' + PayloadDir + ''' -Force"';
  if (not Exec(PowerShell, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ResultCode)) or (ResultCode <> 0) then
    Result := 'Le paquet MINOS n''a pas pu etre decompresse (code ' + IntToStr(ResultCode) + ').';
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  PowerShell: String;
  Updater: String;
  Parameters: String;
  ResultCode: Integer;
begin
  Result := '';
  NeedsRestart := False;

  Result := ExtractMinosPayload();
  if Result <> '' then exit;

  try ExtractTemporaryFile('update-installation.ps1');
  except
    Result := 'Le moteur de mise a jour transactionnel MINOS est introuvable dans cet installateur.';
    exit;
  end;

  PowerShell := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  Updater := ExpandConstant('{tmp}\update-installation.ps1');
  Parameters :=
    '-NoProfile -ExecutionPolicy Bypass -File "' + Updater +
    '" -PackageRoot "' + ExpandConstant('{tmp}\minos-payload') +
    '" -InstallRoot "' + ExpandConstant('{app}') + '"';

  if (not Exec(PowerShell, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ResultCode)) or (ResultCode <> 0) then
    Result :=
      'La mise a jour transactionnelle de MINOS a echoue (code ' + IntToStr(ResultCode) + ').' + #13#10 + #13#10 +
      'Aucune modification partielle n''a ete conservee : toute version precedente a ete restauree automatiquement,' + #13#10 +
      'et aucun fallback silencieux n''a ete applique. Consultez le journal de l''installateur pour le detail.';
end;

procedure RemoveMinosProgramPayload;
var
  PowerShell: String;
  Script: String;
  Parameters: String;
  ResultCode: Integer;
begin
  try ExtractTemporaryFile('uninstall-program-payload.ps1');
  except
    exit;
  end;
  PowerShell := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  Script := ExpandConstant('{tmp}\uninstall-program-payload.ps1');
  Parameters := '-NoProfile -ExecutionPolicy Bypass -File "' + Script + '" -InstallRoot "' + ExpandConstant('{app}') + '"';
  Exec(PowerShell, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
    if WizardIsTaskSelected('addtopath') then AddMinosToUserPath;
    if not ConfigureRuntimeSettings() then exit;
    PersistInstallerRegistry;
    if ConfigureSelectedMcpBackend() then
      ConfigureMcpClients;
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usUninstall then
  begin
    if not IsSmokeBuild() then
    begin
      RemoveMinosFromUserPath;
      PromptForUserDataRemoval;
    end;
  end
  else if CurUninstallStep = usPostUninstall then
  begin
    RemoveMinosProgramPayload;
    DeleteMinosUserData;
  end;
end;
