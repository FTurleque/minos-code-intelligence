procedure SetMcpAvailability(CheckBox: TNewCheckBox; Status: TNewStaticText; Section: String);
var
  Available: Boolean;
  Reason: String;
begin
  Available := GetIniString(Section, 'Available', '0', McpPreflightIni) = '1';
  Reason := GetIniString(Section, 'Reason', 'Détection indisponible', McpPreflightIni);
  CheckBox.Enabled := Available;
  CheckBox.Checked := False;
  Status.Caption := Reason;
end;

procedure DisableAllMcpRows(Reason: String);
begin
  McpCopilotJetBrains.Enabled := False; McpCopilotJetBrains.Checked := False; McpCopilotJetBrainsStatus.Caption := Reason;
  McpCopilotCli.Enabled := False; McpCopilotCli.Checked := False; McpCopilotCliStatus.Caption := Reason;
  McpClaudeCode.Enabled := False; McpClaudeCode.Checked := False; McpClaudeCodeStatus.Caption := Reason;
  McpClaudeDesktop.Enabled := False; McpClaudeDesktop.Checked := False; McpClaudeDesktopStatus.Caption := Reason;
  McpCodexCli.Enabled := False; McpCodexCli.Checked := False; McpCodexCliStatus.Caption := Reason;
  McpCodexDesktop.Enabled := False; McpCodexDesktop.Checked := False; McpCodexDesktopStatus.Caption := Reason;
end;

procedure RunMcpPreflight;
var
  PowerShell: String;
  Detector: String;
  Parameters: String;
  ResultCode: Integer;
begin
  McpPreflightIni := ExpandConstant('{tmp}\minos-mcp-preflight.ini');
  DeleteFile(McpPreflightIni);
  try ExtractTemporaryFile('detect-mcp-clients.ps1');
  except
    DisableAllMcpRows('Détection indisponible — helper MINOS introuvable');
    exit;
  end;
  PowerShell := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  Detector := ExpandConstant('{tmp}\detect-mcp-clients.ps1');
  Parameters := '-NoProfile -ExecutionPolicy Bypass -File "' + Detector + '" -OutputPath "' + McpPreflightIni + '"';
  if (not Exec(PowerShell, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ResultCode)) or
     (ResultCode <> 0) or (not FileExists(McpPreflightIni)) then
  begin
    DisableAllMcpRows('Détection indisponible — le préflight MINOS a échoué');
    exit;
  end;
  SetMcpAvailability(McpCopilotJetBrains, McpCopilotJetBrainsStatus, 'CopilotJetBrains');
  SetMcpAvailability(McpCopilotCli, McpCopilotCliStatus, 'CopilotCli');
  SetMcpAvailability(McpClaudeCode, McpClaudeCodeStatus, 'ClaudeCode');
  SetMcpAvailability(McpClaudeDesktop, McpClaudeDesktopStatus, 'ClaudeDesktop');
  SetMcpAvailability(McpCodexCli, McpCodexCliStatus, 'CodexCli');
  SetMcpAvailability(McpCodexDesktop, McpCodexDesktopStatus, 'CodexDesktop');
end;

function DockerReady(): Boolean;
var
  ResultCode: Integer;
begin
  Result := Exec(ExpandConstant('{cmd}'), '/C docker version >NUL 2>&1', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
end;

function McpClientSelected(): Boolean;
begin
  Result :=
    (McpCopilotJetBrains.Enabled and McpCopilotJetBrains.Checked) or
    (McpCopilotCli.Enabled and McpCopilotCli.Checked) or
    (McpClaudeCode.Enabled and McpClaudeCode.Checked) or
    (McpClaudeDesktop.Enabled and McpClaudeDesktop.Checked) or
    (McpCodexCli.Enabled and McpCodexCli.Checked) or
    (McpCodexDesktop.Enabled and McpCodexDesktop.Checked);
end;

procedure PersistInstallerRegistry;
begin
  if IsSmokeBuild() then exit;
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'SetupMode', IfThen(AdvancedSetupSelected(), 'advanced', 'standard'));
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DataRoot', EffectiveDataRoot());
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerDataRoot', EffectiveDockerDataRoot());
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'McpServerName', EffectiveMcpServerName());
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'McpBackend', EffectiveMcpBackend());
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'StorageBackend', EffectiveStorageBackend());
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'SemanticProvider', EffectiveSemanticProvider());
  RegWriteStringValue(HKCU, InstallerRegistryPath(), 'DockerInstanceName', DockerInstanceEdit.Text);
end;

function ConfigureRuntimeSettings(): Boolean;
var
  ResultCode: Integer;
  Parameters: String;
  PowerShell: String;
  PasswordFile: String;
  SetupMode: String;
begin
  Result := True;
  if IsSmokeBuild() then exit;
  PowerShell := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  if AdvancedSetupSelected() then SetupMode := 'advanced' else SetupMode := 'standard';
  Parameters := '-NoProfile -ExecutionPolicy Bypass -File "' +
    ExpandConstant('{app}\integration\configure-runtime-settings.ps1') +
    '" -DataRoot "' + EffectiveDataRoot() +
    '" -DockerDataRoot "' + EffectiveDockerDataRoot() +
    '" -SetupMode ' + SetupMode +
    ' -McpBackend ' + EffectiveMcpBackend() +
    ' -McpServerName "' + EffectiveMcpServerName() +
    '" -StorageBackend ' + EffectiveStorageBackend() +
    ' -SemanticProvider ' + EffectiveSemanticProvider() +
    ' -DockerInstanceName "' + DockerInstanceEdit.Text + '"';

  PasswordFile := '';
  if PostgreSqlSelected() then
  begin
    if DockerMcpSelected() then
      Parameters := Parameters + ' -ManagedDockerPostgres'
    else
    begin
      PasswordFile := ExpandConstant('{tmp}\minos-postgres-password.txt');
      DeleteFile(PasswordFile);
      SaveStringToFile(PasswordFile, PostgresPasswordEdit.Text + #13#10, False);
      Parameters := Parameters +
        ' -PostgresUrl "' + PostgresUrlEdit.Text +
        '" -PostgresUser "' + PostgresUserEdit.Text +
        '" -PostgresPasswordSourcePath "' + PasswordFile +
        '" -PostgresSchema "' + PostgresSchemaEdit.Text + '"';
    end;
  end;

  if OllamaSelected() then
  begin
    Parameters := Parameters +
      ' -SemanticModel "' + OllamaModelEdit.Text +
      '" -SemanticDimensions ' + OllamaDimensionsEdit.Text;
    if DockerMcpSelected() then
    begin
      if OllamaProvisionCheck.Checked then Parameters := Parameters + ' -ProvisionOllamaModel';
    end
    else
      Parameters := Parameters + ' -SemanticEndpoint "' + OllamaEndpointEdit.Text + '"';
  end;

  if (not Exec(PowerShell, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ResultCode)) or (ResultCode <> 0) then
  begin
    MsgBox(
      'La configuration avancée MINOS n''a pas pu être appliquée.' + #13#10 + #13#10 +
      'Aucun fallback silencieux n''a été utilisé. Consultez le journal de l''installateur.',
      mbError, MB_OK);
    Result := False;
  end;
  if PasswordFile <> '' then DeleteFile(PasswordFile);
end;

function ConfigureSelectedMcpBackend(): Boolean;
var
  ResultCode: Integer;
  Parameters: String;
  PowerShell: String;
  TargetBackend: String;
begin
  Result := True;
  if IsSmokeBuild() or NoMcpSelected() then exit;
  if NativeMcpSelected() then TargetBackend := 'native' else TargetBackend := 'docker';
  PowerShell := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  Parameters := '-NoProfile -ExecutionPolicy Bypass -File "' +
    ExpandConstant('{app}\integration\switch-mcp-backend.ps1') +
    '" -InstallRoot "' + ExpandConstant('{app}') +
    '" -TargetBackend ' + TargetBackend +
    ' -DataRoot "' + EffectiveDataRoot() + '"';
  if DockerMcpSelected() then
    Parameters := Parameters +
      ' -ProjectsRoot "' + DockerProjectsPage.Values[0] +
      '" -DockerDataRoot "' + EffectiveDockerDataRoot() +
      '" -DockerContainerName "' + DockerInstanceEdit.Text +
      '" -DockerComposeProject "' + DockerInstanceEdit.Text + '"';
  if (not Exec(PowerShell, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ResultCode)) or (ResultCode <> 0) then
  begin
    MsgBox(
      'Le backend MCP sélectionné n''a pas atteint son gate de validation/handshake.' + #13#10 + #13#10 +
      'La configuration précédente a été conservée ou restaurée ; aucun fallback silencieux n''a été appliqué.' + #13#10 +
      'Diagnostic : ' + EffectiveDataRoot() + '\runtime\backend-switch.log',
      mbError, MB_OK);
    Result := False;
  end;
end;

procedure ConfigureMcpClients;
var
  ResultCode: Integer;
  Parameters: String;
  PowerShell: String;
begin
  if IsSmokeBuild() or (not McpBackendSelected()) or (not McpClientSelected()) then exit;
  PowerShell := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  Parameters := '-NoProfile -ExecutionPolicy Bypass -File "' +
    ExpandConstant('{app}\integration\configure-mcp-clients-setup.ps1') +
    '" -InstallRoot "' + ExpandConstant('{app}') +
    '" -McpServerName "' + EffectiveMcpServerName() +
    '" -DataRoot "' + EffectiveDataRoot() + '"';
  if McpCopilotJetBrains.Enabled and McpCopilotJetBrains.Checked then Parameters := Parameters + ' -CopilotJetBrains';
  if McpCopilotCli.Enabled and McpCopilotCli.Checked then Parameters := Parameters + ' -CopilotCli';
  if McpClaudeCode.Enabled and McpClaudeCode.Checked then Parameters := Parameters + ' -ClaudeCode';
  if McpClaudeDesktop.Enabled and McpClaudeDesktop.Checked then Parameters := Parameters + ' -ClaudeDesktop';
  if McpCodexCli.Enabled and McpCodexCli.Checked then Parameters := Parameters + ' -Codex -CodexMode cli'
  else if McpCodexDesktop.Enabled and McpCodexDesktop.Checked then Parameters := Parameters + ' -Codex -CodexMode desktop';
  if (not Exec(PowerShell, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ResultCode)) or (ResultCode <> 0) then
  begin
    MsgBox(
      'MINOS est installé et le backend MCP a été validé, mais une ou plusieurs intégrations clientes n''ont pas pu être configurées.' + #13#10 + #13#10 +
      'Le point d''entrée stable minos.exe mcp reste utilisable directement.' + #13#10 +
      'Diagnostic : %LOCALAPPDATA%\MINOS\mcp-clients.log', mbError, MB_OK);
  end;
end;

