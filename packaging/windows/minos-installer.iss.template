#define MinosName "MINOS Code Intelligence"
#define MinosVersion "@@VERSION@@"
#define MinosAppVersion "@@APP_VERSION@@"
#define MinosAppId "@@APP_ID@@"
#define MinosSmokeMode @@SMOKE_MODE@@
#define MinosSourceDir "@@SOURCE_DIR@@"
#define MinosOutputDir "@@OUTPUT_DIR@@"
#define MinosOutputBaseFilename "@@OUTPUT_BASENAME@@"

[Setup]
AppId={#MinosAppId}
AppName={#MinosName}
AppVersion={#MinosVersion}
AppPublisher=FTurleque
DefaultDirName={localappdata}\Programs\MINOS
DefaultGroupName=MINOS
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir={#MinosOutputDir}
OutputBaseFilename={#MinosOutputBaseFilename}
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
ChangesEnvironment=yes
SetupLogging=yes
UninstallDisplayName={#MinosName}
VersionInfoVersion={#MinosAppVersion}
VersionInfoCompany=FTurleque
VersionInfoDescription={#MinosName} Windows installer
VersionInfoProductName={#MinosName}
VersionInfoProductVersion={#MinosAppVersion}
VersionInfoProductTextVersion={#MinosVersion}

[Tasks]
Name: "addtopath"; Description: "Ajouter MINOS au PATH de l'utilisateur"; GroupDescription: "Intégration Windows :"; Flags: checkedonce
Name: "docker"; Description: "Configurer et démarrer le MCP Docker (Docker Desktop requis)"; GroupDescription: "MCP Docker optionnel :"; Flags: unchecked

[Files]
Source: "{#MinosSourceDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; The detector is also embedded for pre-install extraction. It is still installed
; normally by the recursive entry above for diagnostics and manual re-checks.
Source: "{#MinosSourceDir}\integration\detect-mcp-clients.ps1"; Flags: dontcopy

[Icons]
Name: "{userprograms}\MINOS\Dossier d'installation MINOS"; Filename: "{app}"

[UninstallRun]
Filename: "{sys}\WindowsPowerShell\v1.0\powershell.exe"; Parameters: "-NoProfile -ExecutionPolicy Bypass -File ""{app}\integration\uninstall-mcp-clients.ps1"" -InstallRoot ""{app}"""; Flags: runhidden waituntilterminated skipifdoesntexist; RunOnceId: "RemoveMinosNativeMcpClients"; Check: ShouldRunGlobalCleanup
Filename: "{sys}\WindowsPowerShell\v1.0\powershell.exe"; Parameters: "-NoProfile -ExecutionPolicy Bypass -File ""{app}\docker\scripts\configure-docker-mcp.ps1"" -InstallRoot ""{app}"" -Stop"; Flags: runhidden waituntilterminated skipifdoesntexist; RunOnceId: "StopMinosDockerMcp"; Check: ShouldRunGlobalCleanup

[UninstallDelete]
Type: files; Name: "{app}\.docker-mcp-managed"

[Code]
var
  McpClientsPage: TWizardPage;
  McpCopilotJetBrains: TNewCheckBox;
  McpCopilotJetBrainsStatus: TNewStaticText;
  McpCopilotCli: TNewCheckBox;
  McpCopilotCliStatus: TNewStaticText;
  McpClaudeCode: TNewCheckBox;
  McpClaudeCodeStatus: TNewStaticText;
  McpClaudeDesktop: TNewCheckBox;
  McpClaudeDesktopStatus: TNewStaticText;
  McpCodex: TNewCheckBox;
  McpCodexStatus: TNewStaticText;
  McpPreflightIni: String;
  DockerProjectsPage: TInputDirWizardPage;
  DockerWarningShown: Boolean;

function IsSmokeBuild(): Boolean;
begin
  Result := {#MinosSmokeMode} = 1;
end;

function ShouldRunGlobalCleanup(): Boolean;
begin
  Result := not IsSmokeBuild();
end;

function TrimTrailingBackslash(Value: String): String;
begin
  Result := Value;
  while (Length(Result) > 3) and (Result[Length(Result)] = '\') do
    Delete(Result, Length(Result), 1);
end;

function PathContainsEntry(PathValue: String; Entry: String): Boolean;
var
  Haystack: String;
  Needle: String;
begin
  Haystack := ';' + Lowercase(PathValue) + ';';
  Needle := ';' + Lowercase(TrimTrailingBackslash(Entry)) + ';';
  Result := Pos(Needle, Haystack) > 0;
end;

procedure AddMinosToUserPath;
var
  CurrentPath: String;
  AppPath: String;
begin
  if IsSmokeBuild() then
    exit;

  AppPath := TrimTrailingBackslash(ExpandConstant('{app}'));
  if not RegQueryStringValue(HKCU, 'Environment', 'Path', CurrentPath) then
    CurrentPath := '';

  if not PathContainsEntry(CurrentPath, AppPath) then
  begin
    if CurrentPath <> '' then
    begin
      if CurrentPath[Length(CurrentPath)] <> ';' then
        CurrentPath := CurrentPath + ';';
    end;
    CurrentPath := CurrentPath + AppPath;
    RegWriteExpandStringValue(HKCU, 'Environment', 'Path', CurrentPath);
    RegWriteStringValue(HKCU, 'Software\FTurleque\MINOS', 'ManagedPath', AppPath);
  end;
end;

procedure RemoveMinosFromUserPath;
var
  CurrentPath: String;
  AppPath: String;
  PaddedPath: String;
  Needle: String;
  ManagedPath: String;
begin
  if IsSmokeBuild() then
    exit;

  if not RegQueryStringValue(HKCU, 'Software\FTurleque\MINOS', 'ManagedPath', ManagedPath) then
    exit;

  if not RegQueryStringValue(HKCU, 'Environment', 'Path', CurrentPath) then
  begin
    RegDeleteValue(HKCU, 'Software\FTurleque\MINOS', 'ManagedPath');
    exit;
  end;

  AppPath := TrimTrailingBackslash(ManagedPath);
  PaddedPath := ';' + CurrentPath + ';';
  Needle := ';' + AppPath + ';';
  StringChangeEx(PaddedPath, Needle, ';', True);

  while (Length(PaddedPath) > 0) and (PaddedPath[1] = ';') do
    Delete(PaddedPath, 1, 1);
  while (Length(PaddedPath) > 0) and (PaddedPath[Length(PaddedPath)] = ';') do
    Delete(PaddedPath, Length(PaddedPath), 1);

  RegWriteExpandStringValue(HKCU, 'Environment', 'Path', PaddedPath);
  RegDeleteValue(HKCU, 'Software\FTurleque\MINOS', 'ManagedPath');
end;

procedure ConfigureMcpRow(CheckBox: TNewCheckBox; Status: TNewStaticText; Top: Integer; Caption: String);
begin
  CheckBox.Parent := McpClientsPage.Surface;
  CheckBox.Left := 0;
  CheckBox.Top := Top;
  CheckBox.Width := McpClientsPage.SurfaceWidth;
  CheckBox.Caption := Caption;
  CheckBox.Checked := False;

  Status.Parent := McpClientsPage.Surface;
  Status.Left := ScaleX(13);
  Status.Top := Top + ScaleY(21);
  Status.Width := McpClientsPage.SurfaceWidth - ScaleX(13);
  Status.AutoSize := False;
  Status.Height := ScaleY(28);
  Status.WordWrap := True;
end;

procedure SetMcpAvailability(CheckBox: TNewCheckBox; Status: TNewStaticText; Section: String);
var
  Available: Boolean;
  Reason: String;
begin
  Available := GetIniString(Section, 'Available', '0', McpPreflightIni) = '1';
  Reason := GetIniString(Section, 'Reason', 'Détection indisponible', McpPreflightIni);
  CheckBox.Enabled := Available;
  CheckBox.Checked := False;
  Status.Caption := Reason;
end;

procedure DisableAllMcpRows(Reason: String);
begin
  McpCopilotJetBrains.Enabled := False;
  McpCopilotJetBrains.Checked := False;
  McpCopilotJetBrainsStatus.Caption := Reason;
  McpCopilotCli.Enabled := False;
  McpCopilotCli.Checked := False;
  McpCopilotCliStatus.Caption := Reason;
  McpClaudeCode.Enabled := False;
  McpClaudeCode.Checked := False;
  McpClaudeCodeStatus.Caption := Reason;
  McpClaudeDesktop.Enabled := False;
  McpClaudeDesktop.Checked := False;
  McpClaudeDesktopStatus.Caption := Reason;
  McpCodex.Enabled := False;
  McpCodex.Checked := False;
  McpCodexStatus.Caption := Reason;
end;

procedure RunMcpPreflight;
var
  PowerShell: String;
  Detector: String;
  Parameters: String;
  ResultCode: Integer;
begin
  McpPreflightIni := ExpandConstant('{tmp}\minos-mcp-preflight.ini');
  DeleteFile(McpPreflightIni);

  try
    ExtractTemporaryFile('detect-mcp-clients.ps1');
  except
    DisableAllMcpRows('Détection indisponible — helper MINOS introuvable');
    exit;
  end;

  PowerShell := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  Detector := ExpandConstant('{tmp}\detect-mcp-clients.ps1');
  Parameters := '-NoProfile -ExecutionPolicy Bypass -File "' + Detector + '" -OutputPath "' + McpPreflightIni + '"';

  if (not Exec(PowerShell, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ResultCode)) or
     (ResultCode <> 0) or (not FileExists(McpPreflightIni)) then
  begin
    DisableAllMcpRows('Détection indisponible — le préflight MINOS a échoué');
    exit;
  end;

  SetMcpAvailability(McpCopilotJetBrains, McpCopilotJetBrainsStatus, 'CopilotJetBrains');
  SetMcpAvailability(McpCopilotCli, McpCopilotCliStatus, 'CopilotCli');
  SetMcpAvailability(McpClaudeCode, McpClaudeCodeStatus, 'ClaudeCode');
  SetMcpAvailability(McpClaudeDesktop, McpClaudeDesktopStatus, 'ClaudeDesktop');
  SetMcpAvailability(McpCodex, McpCodexStatus, 'Codex');
end;

function DockerReady(): Boolean;
var
  ResultCode: Integer;
begin
  Result := Exec(ExpandConstant('{cmd}'), '/C docker version >NUL 2>&1', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) and (ResultCode = 0);
end;

function GetDockerProjectsRoot(Param: String): String;
begin
  Result := DockerProjectsPage.Values[0];
end;

function NativeMcpClientSelected(): Boolean;
begin
  Result :=
    (McpCopilotJetBrains.Enabled and McpCopilotJetBrains.Checked) or
    (McpCopilotCli.Enabled and McpCopilotCli.Checked) or
    (McpClaudeCode.Enabled and McpClaudeCode.Checked) or
    (McpClaudeDesktop.Enabled and McpClaudeDesktop.Checked) or
    (McpCodex.Enabled and McpCodex.Checked);
end;

procedure ConfigureNativeMcpClients;
var
  ResultCode: Integer;
  Parameters: String;
  PowerShell: String;
begin
  if IsSmokeBuild() or (not NativeMcpClientSelected()) then
    exit;

  PowerShell := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  Parameters := '-NoProfile -ExecutionPolicy Bypass -File "' +
    ExpandConstant('{app}\integration\configure-mcp-clients-setup.ps1') +
    '" -InstallRoot "' + ExpandConstant('{app}') + '"';

  if McpCopilotJetBrains.Enabled and McpCopilotJetBrains.Checked then Parameters := Parameters + ' -CopilotJetBrains';
  if McpCopilotCli.Enabled and McpCopilotCli.Checked then Parameters := Parameters + ' -CopilotCli';
  if McpClaudeCode.Enabled and McpClaudeCode.Checked then Parameters := Parameters + ' -ClaudeCode';
  if McpClaudeDesktop.Enabled and McpClaudeDesktop.Checked then Parameters := Parameters + ' -ClaudeDesktop';
  if McpCodex.Enabled and McpCodex.Checked then Parameters := Parameters + ' -Codex';

  if (not Exec(PowerShell, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ResultCode)) or (ResultCode <> 0) then
  begin
    MsgBox(
      'MINOS est installé, mais une ou plusieurs intégrations MCP natives n''ont pas pu être configurées.' + #13#10 + #13#10 +
      'Le CLI et le MCP natif restent utilisables directement.' + #13#10 +
      'Diagnostic : %LOCALAPPDATA%\MINOS\mcp-clients.log',
      mbError,
      MB_OK);
  end;
end;

procedure ConfigureDockerMcp;
var
  ResultCode: Integer;
  Parameters: String;
  PowerShell: String;
begin
  if IsSmokeBuild() then
    exit;

  PowerShell := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
  Parameters := '-NoProfile -ExecutionPolicy Bypass -File "' +
    ExpandConstant('{app}\docker\scripts\configure-docker-mcp.ps1') +
    '" -InstallRoot "' + ExpandConstant('{app}') +
    '" -ProjectsRoot "' + DockerProjectsPage.Values[0] +
    '" -Start -Strict';

  if (not Exec(PowerShell, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ResultCode)) or (ResultCode <> 0) then
  begin
    MsgBox(
      'MINOS est installé, mais la configuration du MCP Docker a échoué.' + #13#10 + #13#10 +
      'Le CLI et le MCP natif restent utilisables.' + #13#10 +
      'Diagnostic : %LOCALAPPDATA%\MINOS\docker-setup.log',
      mbError,
      MB_OK);
  end;
end;

procedure InitializeWizard;
var
  RequestedRoot: String;
begin
  McpClientsPage := CreateCustomPage(
    wpSelectDir,
    'Intégrations MCP natives',
    'Connecter le MCP natif MINOS à vos clients IA détectés');

  McpCopilotJetBrains := TNewCheckBox.Create(McpClientsPage);
  McpCopilotJetBrainsStatus := TNewStaticText.Create(McpClientsPage);
  ConfigureMcpRow(McpCopilotJetBrains, McpCopilotJetBrainsStatus, ScaleY(8), 'GitHub Copilot — JetBrains / IntelliJ');

  McpCopilotCli := TNewCheckBox.Create(McpClientsPage);
  McpCopilotCliStatus := TNewStaticText.Create(McpClientsPage);
  ConfigureMcpRow(McpCopilotCli, McpCopilotCliStatus, ScaleY(62), 'GitHub Copilot CLI');

  McpClaudeCode := TNewCheckBox.Create(McpClientsPage);
  McpClaudeCodeStatus := TNewStaticText.Create(McpClientsPage);
  ConfigureMcpRow(McpClaudeCode, McpClaudeCodeStatus, ScaleY(116), 'Claude Code');

  McpClaudeDesktop := TNewCheckBox.Create(McpClientsPage);
  McpClaudeDesktopStatus := TNewStaticText.Create(McpClientsPage);
  ConfigureMcpRow(McpClaudeDesktop, McpClaudeDesktopStatus, ScaleY(170), 'Claude Desktop');

  McpCodex := TNewCheckBox.Create(McpClientsPage);
  McpCodexStatus := TNewStaticText.Create(McpClientsPage);
  ConfigureMcpRow(McpCodex, McpCodexStatus, ScaleY(224), 'OpenAI Codex');

  RunMcpPreflight;

  DockerWarningShown := False;
  DockerProjectsPage := CreateInputDirPage(
    wpSelectTasks,
    'MCP Docker MINOS',
    'Choisissez la racine des projets exposés au MCP Docker',
    'Les projets de cette racine seront montés en lecture seule dans le conteneur MINOS.',
    False,
    '');
  DockerProjectsPage.Add('Racine des projets :');

  RequestedRoot := ExpandConstant('{param:DOCKERPROJECTSROOT|}');
  if RequestedRoot <> '' then DockerProjectsPage.Values[0] := RequestedRoot
  else DockerProjectsPage.Values[0] := ExpandConstant('{%USERPROFILE}');
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := (PageID = DockerProjectsPage.ID) and (not WizardIsTaskSelected('docker'));
end;

function NextButtonClick(CurPageID: Integer): Boolean;
begin
  Result := True;
  if (CurPageID = DockerProjectsPage.ID) and WizardIsTaskSelected('docker') then
  begin
    if not DirExists(DockerProjectsPage.Values[0]) then
    begin
      MsgBox('La racine des projets n''existe pas. Choisissez un dossier existant.', mbError, MB_OK);
      Result := False;
      exit;
    end;

    if (not DockerReady()) and (not DockerWarningShown) then
    begin
      DockerWarningShown := True;
      MsgBox(
        'Docker Desktop n''est pas disponible ou son daemon n''est pas démarré.' + #13#10 + #13#10 +
        'MINOS sera installé normalement, mais la configuration du MCP Docker sera ignorée. ' +
        'Vous pourrez la lancer plus tard depuis les scripts installés.',
        mbInformation,
        MB_OK);
    end;
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
    if WizardIsTaskSelected('addtopath') then AddMinosToUserPath;
    ConfigureNativeMcpClients;
    if WizardIsTaskSelected('docker') and DockerReady() then ConfigureDockerMcp;
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if (CurUninstallStep = usUninstall) and (not IsSmokeBuild()) then
    RemoveMinosFromUserPath;
end;
