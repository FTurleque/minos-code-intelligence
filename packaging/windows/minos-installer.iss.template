#define MinosName "MINOS Code Intelligence"
#define MinosVersion "@@VERSION@@"
#define MinosAppVersion "@@APP_VERSION@@"
#define MinosAppId "@@APP_ID@@"
#define MinosSmokeMode @@SMOKE_MODE@@
#define MinosSourceDir "@@SOURCE_DIR@@"
#define MinosPayloadZip "@@PAYLOAD_ZIP@@"
#define MinosOutputDir "@@OUTPUT_DIR@@"
#define MinosOutputBaseFilename "@@OUTPUT_BASENAME@@"

[Setup]
AppId={#MinosAppId}
AppName={#MinosName}
AppVersion={#MinosVersion}
AppPublisher=FTurleque
DefaultDirName={localappdata}\Programs\MINOS
DefaultGroupName=MINOS
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir={#MinosOutputDir}
OutputBaseFilename={#MinosOutputBaseFilename}
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
ChangesEnvironment=yes
SetupLogging=yes
; An upgrade reuses the previous {app} directory -- PrepareToInstall below
; delegates the actual payload swap to the transactional updater before Inno
; commits any of its own metadata.
UsePreviousAppDir=yes
; The payload is no longer tracked file-by-file in Inno's own uninstall log
; (see [Files] below -- update-installation.ps1 owns the program directories
; instead), so the log is kept fresh on every install rather than appended,
; and CurUninstallStepChanged removes the managed directories itself.
UninstallLogMode=overwrite
UninstallDisplayName={#MinosName}
VersionInfoVersion={#MinosAppVersion}
VersionInfoCompany=FTurleque
VersionInfoDescription={#MinosName} Windows installer
VersionInfoProductName={#MinosName}
VersionInfoProductVersion={#MinosAppVersion}
VersionInfoProductTextVersion={#MinosVersion}

[Tasks]
Name: "addtopath"; Description: "Ajouter MINOS au PATH de l'utilisateur"; GroupDescription: "Intégration Windows :"; Flags: checkedonce

[Files]
; The setup never overwrites {app} directly. update-installation.ps1 performs
; a staged, ownership-checked, rollback-capable activation of this payload
; zip in PrepareToInstall before Inno writes any of its own setup metadata.
Source: "{#MinosPayloadZip}"; Flags: dontcopy noencryption
Source: "{#MinosSourceDir}\integration\update-installation.ps1"; Flags: dontcopy
Source: "{#MinosSourceDir}\integration\uninstall-program-payload.ps1"; Flags: dontcopy
Source: "{#MinosSourceDir}\integration\detect-mcp-clients.ps1"; Flags: dontcopy

[Icons]
Name: "{userprograms}\MINOS\Dossier d'installation MINOS"; Filename: "{app}"

[UninstallRun]
Filename: "{sys}\WindowsPowerShell\v1.0\powershell.exe"; Parameters: "-NoProfile -ExecutionPolicy Bypass -File ""{app}\integration\uninstall-mcp-clients.ps1"" -InstallRoot ""{app}"""; Flags: runhidden waituntilterminated skipifdoesntexist; RunOnceId: "RemoveMinosNativeMcpClients"; Check: ShouldRunGlobalCleanup
Filename: "{sys}\WindowsPowerShell\v1.0\powershell.exe"; Parameters: "-NoProfile -ExecutionPolicy Bypass -File ""{app}\docker\scripts\configure-docker-mcp.ps1"" -InstallRoot ""{app}"" -Stop"; Flags: runhidden waituntilterminated skipifdoesntexist; RunOnceId: "StopMinosDockerMcp"; Check: ShouldRunGlobalCleanup

[UninstallDelete]
Type: files; Name: "{app}\.docker-mcp-managed"

