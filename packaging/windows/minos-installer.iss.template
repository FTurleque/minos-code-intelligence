procedure UpdateSummary;
var
  Text: String;
  Clients: String;
  ManagedComponents: String;
begin
  Clients := '';
  if McpCopilotJetBrains.Checked then Clients := Clients + 'Copilot JetBrains, ';
  if McpCopilotCli.Checked then Clients := Clients + 'Copilot CLI, ';
  if McpClaudeCode.Checked then Clients := Clients + 'Claude CLI / Code, ';
  if McpClaudeDesktop.Checked then Clients := Clients + 'Claude Desktop, ';
  if McpCodexCli.Checked then Clients := Clients + 'Codex CLI, ';
  if McpCodexDesktop.Checked then Clients := Clients + 'Codex Desktop, ';
  if Clients = '' then Clients := 'aucun'
  else Delete(Clients, Length(Clients) - 1, 2);

  ManagedComponents := 'runtime MINOS';
  if DockerMcpSelected() then ManagedComponents := ManagedComponents + ', runtime MCP Docker';
  if DockerMcpSelected() and PostgreSqlSelected() then ManagedComponents := ManagedComponents + ', PostgreSQL/pgvector Docker';
  if DockerMcpSelected() and OllamaSelected() then
  begin
    ManagedComponents := ManagedComponents + ', Ollama Docker';
    if OllamaProvisionCheck.Checked then ManagedComponents := ManagedComponents + ' + modèle ' + OllamaModelEdit.Text;
  end;

  Text :=
    'Type d''installation : ' + IfThen(AdvancedSetupSelected(), 'Avancée', 'Standard') + #13#10 +
    'Programme : ' + ExpandConstant('{app}') + #13#10 +
    'Données natives / contrôle : ' + EffectiveDataRoot() + #13#10 +
    'Backend MCP : ' + EffectiveMcpBackend() + #13#10 +
    'Nom serveur MCP : ' + EffectiveMcpServerName() + #13#10 +
    'Stockage : ' + EffectiveStorageBackend() + #13#10 +
    'Recherche sémantique : ' + EffectiveSemanticProvider() + #13#10 +
    'Clients IA : ' + Clients + #13#10 +
    'Composants gérés par MINOS : ' + ManagedComponents;
  if DockerMcpSelected() then
  begin
    Text := Text + #13#10 +
      'Racine projets Docker : ' + DockerProjectsPage.Values[0] + #13#10 +
      'Données Docker : ' + EffectiveDockerDataRoot() + #13#10 +
      'Instance Docker : ' + DockerInstanceEdit.Text;
    if PostgreSqlSelected() then Text := Text + #13#10 + 'PostgreSQL : géré par MINOS dans Docker (pgvector)';
    if OllamaSelected() then
    begin
      Text := Text + #13#10 + 'Ollama : sidecar Docker géré, modèle ' + OllamaModelEdit.Text;
      if OllamaProvisionCheck.Checked then Text := Text + ' — téléchargement/provisionnement demandé'
      else Text := Text + ' — modèle déjà présent attendu';
    end;
  end
  else
  begin
    if PostgreSqlSelected() then Text := Text + #13#10 + 'PostgreSQL : externe — ' + PostgresUrlEdit.Text;
    if OllamaSelected() then Text := Text + #13#10 + 'Ollama : instance locale/externe existante — aucun binaire Ollama installé par MINOS';
  end;
  SummaryMemo.Text := Text;
end;

