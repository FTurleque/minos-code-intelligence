function IfThen(Condition: Boolean; TrueValue, FalseValue: String): String;
begin
  if Condition then Result := TrueValue else Result := FalseValue;
end;

function IsSmokeBuild(): Boolean;
begin
  Result := {#MinosSmokeMode} = 1;
end;

function ShouldRunGlobalCleanup(): Boolean;
begin
  Result := not IsSmokeBuild();
end;

function AdvancedSetupSelected(): Boolean;
begin
  Result := SetupTypePage.Values[1];
end;

function NativeMcpSelected(): Boolean;
begin
  Result := McpModePage.Values[0];
end;

