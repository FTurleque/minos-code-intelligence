function InstallerRegistryPath(): String;
begin
  Result := 'Software\FTurleque\MINOS';
end;

function ReadInstallerValue(Name: String; DefaultValue: String): String;
var
  Value: String;
begin
  if RegQueryStringValue(HKCU, InstallerRegistryPath(), Name, Value) and (Value <> '') then
    Result := Value
  else
    Result := DefaultValue;
end;

function DefaultDataRoot(): String;
begin
  Result := ExpandConstant('{localappdata}\MINOS\data');
end;

function DefaultDockerDataRoot(): String;
begin
  Result := ExpandConstant('{localappdata}\MINOS\docker-data');
end;

function EffectiveDataRoot(): String;
begin
  if AdvancedSetupSelected() then Result := DataRootPage.Values[0]
  else Result := DefaultDataRoot();
end;

function EffectiveDockerDataRoot(): String;
begin
  if AdvancedSetupSelected() then Result := DockerDataRootEdit.Text
  else Result := DefaultDockerDataRoot();
end;

function EffectiveMcpServerName(): String;
begin
  if AdvancedSetupSelected() then Result := McpNamePage.Values[0]
  else Result := 'minos';
end;

function EffectiveStorageBackend(): String;
begin
  if PostgreSqlSelected() then Result := 'postgresql'
  else Result := 'local';
end;

function EffectiveSemanticProvider(): String;
begin
  if OllamaSelected() then Result := 'ollama'
  else if LocalHashSelected() then Result := 'local-hash'
  else Result := 'disabled';
end;

function EffectiveMcpBackend(): String;
begin
  if NativeMcpSelected() then Result := 'native'
  else if DockerMcpSelected() then Result := 'docker'
  else Result := 'none';
end;

function ExistingMcpBackend(): String;
var
  ConfigPath: String;
  ConfigText: AnsiString;
begin
  Result := ReadInstallerValue('McpBackend', '');
  if (Result = 'native') or (Result = 'docker') then exit;
  Result := '';
  ConfigPath := ExpandConstant('{localappdata}\MINOS\data\runtime\backend.properties');
  if not FileExists(ConfigPath) then
    ConfigPath := AddBackslash(ReadInstallerValue('DataRoot', DefaultDataRoot())) + 'runtime\backend.properties';
  if FileExists(ConfigPath) and LoadStringFromFile(ConfigPath, ConfigText) then
  begin
    if Pos('backend=docker', LowerCase(ConfigText)) > 0 then Result := 'docker'
    else if Pos('backend=native', LowerCase(ConfigText)) > 0 then Result := 'native';
  end;
end;

function TrimTrailingBackslash(Value: String): String;
begin
  Result := Value;
  while (Length(Result) > 3) and (Result[Length(Result)] = '\') do
    Delete(Result, Length(Result), 1);
end;

function PathContainsEntry(PathValue: String; Entry: String): Boolean;
var
  Haystack: String;
  Needle: String;
begin
  Haystack := ';' + Lowercase(PathValue) + ';';
  Needle := ';' + Lowercase(TrimTrailingBackslash(Entry)) + ';';
  Result := Pos(Needle, Haystack) > 0;
end;

procedure AddMinosToUserPath;
var
  CurrentPath: String;
  AppPath: String;
begin
  if IsSmokeBuild() then exit;
  AppPath := TrimTrailingBackslash(ExpandConstant('{app}'));
  if not RegQueryStringValue(HKCU, 'Environment', 'Path', CurrentPath) then CurrentPath := '';
  if not PathContainsEntry(CurrentPath, AppPath) then
  begin
    if CurrentPath <> '' then
    begin
      if CurrentPath[Length(CurrentPath)] <> ';' then CurrentPath := CurrentPath + ';';
    end;
    CurrentPath := CurrentPath + AppPath;
    RegWriteExpandStringValue(HKCU, 'Environment', 'Path', CurrentPath);
    RegWriteStringValue(HKCU, InstallerRegistryPath(), 'ManagedPath', AppPath);
  end;
end;

procedure RemoveMinosFromUserPath;
var
  CurrentPath: String;
  AppPath: String;
  PaddedPath: String;
  Needle: String;
  ManagedPath: String;
begin
  if IsSmokeBuild() then exit;
  if not RegQueryStringValue(HKCU, InstallerRegistryPath(), 'ManagedPath', ManagedPath) then exit;
  if not RegQueryStringValue(HKCU, 'Environment', 'Path', CurrentPath) then
  begin
    RegDeleteValue(HKCU, InstallerRegistryPath(), 'ManagedPath');
    exit;
  end;
  AppPath := TrimTrailingBackslash(ManagedPath);
  PaddedPath := ';' + CurrentPath + ';';
  Needle := ';' + AppPath + ';';
  StringChangeEx(PaddedPath, Needle, ';', True);
  while (Length(PaddedPath) > 0) and (PaddedPath[1] = ';') do Delete(PaddedPath, 1, 1);
  while (Length(PaddedPath) > 0) and (PaddedPath[Length(PaddedPath)] = ';') do Delete(PaddedPath, Length(PaddedPath), 1);
  RegWriteExpandStringValue(HKCU, 'Environment', 'Path', PaddedPath);
  RegDeleteValue(HKCU, InstallerRegistryPath(), 'ManagedPath');
end;

function IsAbsoluteWindowsPath(Value: String): Boolean;
begin
  Result := ((Length(Value) >= 3) and (Value[2] = ':') and ((Value[3] = '\') or (Value[3] = '/'))) or
            ((Length(Value) >= 2) and (Copy(Value, 1, 2) = '\\'));
end;

function IsSafeIdentifier(Value: String): Boolean;
var
  I: Integer;
  C: Char;
begin
  Result := False;
  if (Length(Value) < 1) or (Length(Value) > 63) then exit;
  C := Value[1];
  if not (((C >= 'A') and (C <= 'Z')) or ((C >= 'a') and (C <= 'z')) or (C = '_')) then exit;
  for I := 2 to Length(Value) do
  begin
    C := Value[I];
    if not (((C >= 'A') and (C <= 'Z')) or ((C >= 'a') and (C <= 'z')) or
            ((C >= '0') and (C <= '9')) or (C = '_')) then exit;
  end;
  Result := True;
end;

function IsSafeMcpName(Value: String): Boolean;
var
  I: Integer;
  C: Char;
begin
  Result := False;
  if (Length(Value) < 1) or (Length(Value) > 64) then exit;
  C := Value[1];
  if not (((C >= 'A') and (C <= 'Z')) or ((C >= 'a') and (C <= 'z'))) then exit;
  for I := 2 to Length(Value) do
  begin
    C := Value[I];
    if not (((C >= 'A') and (C <= 'Z')) or ((C >= 'a') and (C <= 'z')) or
            ((C >= '0') and (C <= '9')) or (C = '_') or (C = '-')) then exit;
  end;
  Result := True;
end;

function IsSafeDockerName(Value: String): Boolean;
var
  I: Integer;
  C: Char;
begin
  Result := False;
  if (Length(Value) < 2) or (Length(Value) > 64) then exit;
  for I := 1 to Length(Value) do
  begin
    C := Value[I];
    if not (((C >= 'A') and (C <= 'Z')) or ((C >= 'a') and (C <= 'z')) or
            ((C >= '0') and (C <= '9')) or (C = '_') or (C = '-') or (C = '.')) then exit;
  end;
  Result := True;
end;

function ContainsUnsafeCommandText(Value: String): Boolean;
begin
  Result := (Pos('"', Value) > 0) or (Pos(#13, Value) > 0) or (Pos(#10, Value) > 0);
end;

