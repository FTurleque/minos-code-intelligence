  "extraDiscoveryRoots": ["repo:"],
  "warmup": 3,
  "iterations": 15,
  "ratioIterations": 3,
  "loadIterations": 5,
  "architectureWarmup": 1,
  "architectureIterations": 5,
  "profileMillis": 5000,
  "sections": ["memory", "hybrid", "impact", "architecture"]
}
