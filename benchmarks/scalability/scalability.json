{
  "benchmark": "snapshot-scalability",
  "mainClass": "com.minos.bootstrap.scalability.SnapshotScalabilityBenchmark",
  "jvmArguments": ["-Xmx24g"],
  "sourceRoot": "corpus:minos-src",
  "mainScip": { "label": "minos-full", "provider": "scip-java", "providerVersion": "0.13.1", "path": "corpus:minos-full.scip" },
  "ratioScips": [
    { "label": "minos-app-module", "provider": "scip-java", "providerVersion": "0.13.1", "path": "corpus:minos-app-module.scip", "optional": true },
    { "label": "ariane-chatbot", "provider": "scip-java", "providerVersion": "0.13.1", "path": "corpus:ariane-chatbot.scip", "optional": true },
    { "label": "nexus-context-engine", "provider": "scip-java", "providerVersion": "0.13.1", "path": "corpus:nexus-context-engine.scip", "optional": true },
    { "label": "typescript-simple", "provider": "scip-typescript", "providerVersion": "0.4.0", "path": "repo:fixtures/typescript/typescript-simple/.minos-m0/scip-typescript/index.scip" },
    { "label": "typescript-modules", "provider": "scip-typescript", "providerVersion": "0.4.0", "path": "repo:fixtures/typescript/typescript-modules/.minos-m0/scip-typescript/index.scip" },
    { "label": "typescript-inheritance", "provider": "scip-typescript", "providerVersion": "0.4.0", "path": "repo:fixtures/typescript/typescript-inheritance/.minos-m0/scip-typescript/index.scip" }
  ],
  "fractions": [0.25, 0.5, 0.9, 1.0],
  "replicas": [1],
  "queries": ["snapshot store", "ImpactAnalysisService", "hybrid search normalize query", "publish knowledge snapshot pointer"],
