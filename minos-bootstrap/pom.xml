<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.minos</groupId>
        <artifactId>minos-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>minos-bootstrap</artifactId>
    <name>MINOS Bootstrap</name>
    <description>Composition root (ADR 0042): the only non-adapter module that wires concrete adapters behind the ports of minos-application.</description>

    <dependencies>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- MINOS-AUD-D01: UnreadableDirectory (com.minos.testsupport), one copy for the tests of every module; test scope adds no edge (compile edge to minos-engine already exists) -->
            <groupId>com.minos</groupId>
            <artifactId>minos-engine</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-runtime-local</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-storage</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-provider-scip</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-integration-git</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          A2 / ADR 0042 (C5): application x PostgreSQL integration tests live in the composition root,
          the module where the application meets its adapters. PostgreSQL stays optional in production: it is
          discovered by ServiceLoader (StorageBackendSelection), no production class of this module names it
          (rule R1 of check-module-boundaries.py) and the local composition loads none of its classes
          (LocalCompositionLoadsNoPostgresqlClassTest). The test-jar of minos-storage carries PostgresTestSupport,
          which connects to a PostgreSQL server started outside the test JVM (scripts/dev/start-test-postgres.sh).
        -->
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-storage</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!--
                  A1-3 / A2: test fixtures (LocalRemoteIndexingRuntimeFixtures, and ResumableRunFixtures for A4) are published
                  as a test-jar for the minos-cli and minos-mcp tests, so the production jar keeps no public injection point.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven.jar.plugin.version}</version>
                <executions>
                    <execution>
                        <goals><goal>test-jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- ADR 0068 section 4: the PostgreSQL backend is registered by the minos-app assembly only. The tests of
                         this module that select it get the registration from this directory, kept out of
                         target/test-classes so that the test-jar used by the surfaces does not carry it -->
                    <additionalClasspathElements>
                        <additionalClasspathElement>${project.basedir}/src/test/postgresql-backend</additionalClasspathElement>
                    </additionalClasspathElements>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
