<?xml version="1.0" encoding="UTF-8"?>
<!--
  MINOS-AUD-H02: false CPE matches of MINOS's own modules only. Each rule is bound to one com.minos artifact AND one
  CPE, so a real vulnerability of a third-party dependency is never hidden. failBuildOnUnusedSuppressionRule=true
  fails the analysis as soon as a rule stops matching, so it is removed instead of lingering.
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <suppress>
        <notes><![CDATA[
        minos-storage-postgresql is MINOS's PostgreSQL storage adapter, not the PostgreSQL server: the name match
        attaches every CVE of the server (43 on 2026-10-08). The real JDBC driver, org.postgresql:postgresql, is
        analysed separately and is not affected by this rule.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.minos/minos\-storage\-postgresql@.*$</packageUrl>
        <cpe>cpe:/a:postgresql:postgresql</cpe>
    </suppress>
    <suppress>
        <notes><![CDATA[
        minos-nexus is MINOS's Nexus integration module, not the "project-nexus" product.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.minos/minos\-nexus@.*$</packageUrl>
        <cpe>cpe:/a:project-nexus_project:project-nexus</cpe>
    </suppress>
</suppressions>
