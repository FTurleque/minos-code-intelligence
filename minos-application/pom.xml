<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.minos</groupId>
        <artifactId>minos-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>minos-application</artifactId>
    <name>MINOS Application Services</name>
    <description>Application services and ports consumed by public surfaces; concrete adapters are wired by minos-bootstrap (ADR 0042).</description>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- SH-08: IcaclsTestAccessControl (com.minos.testsupport), the platform access control of the Windows tests of
                 a module that cannot see minos-runtime-local; test scope adds no edge (compile edge to minos-engine already exists) -->
            <groupId>com.minos</groupId>
            <artifactId>minos-engine</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!--
                  AUD-ARC-02 / ADR 0087 section 2: MinosApplicationTestAccess, the test access to the package-private ports
                  of MinosApplication, is published as a test-jar for the tests of the other modules, declared in test scope
                  only (check-module-boundaries.py). The test-jar carries that class alone: no other test class and no
                  service declaration (src/test/platform-access-control stays out of it). The guard requires this single
                  test-jar execution and this exact include (check_application_test_jar_content); the packaging IT
                  ApplicationTestAccessPackagingIT checks the entries of the jar actually built.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven.jar.plugin.version}</version>
                <executions>
                    <execution>
                        <goals><goal>test-jar</goal></goals>
                        <configuration>
                            <includes><include>com/minos/application/MinosApplicationTestAccess.class</include></includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- SH-08: registers IcaclsTestAccessControl (minos-engine test-jar) as the platform access control of this
                         module's tests, which cannot see minos-runtime-local; kept out of target/test-classes so that no
                         module using a test-jar of this one finds a second implementation -->
                    <additionalClasspathElements>
                        <additionalClasspathElement>${project.basedir}/src/test/platform-access-control</additionalClasspathElement>
                    </additionalClasspathElements>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
