<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.minos</groupId>
    <artifactId>minos-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>MINOS Parent</name>
    <description>Parent reactor for MINOS Code Intelligence.</description>

    <licenses>
        <license>
            <name>MINOS Proprietary Source-Available License - All Rights Reserved</name>
            <url>https://github.com/FTurleque/minos-code-intelligence/blob/main/LICENSE</url>
            <distribution>repo</distribution>
            <comments>Copyright (c) 2026 Fabrice Turleque. No general use, execution, modification, distribution or commercial license is granted.</comments>
        </license>
    </licenses>

    <modules>
        <module>minos-domain</module>
        <module>minos-engine</module>
        <module>minos-runtime-local</module>
        <module>minos-storage-local</module>
        <module>minos-provider-scip</module>
        <module>minos-integration-git</module>
        <module>minos-application</module>
        <module>minos-storage-postgresql</module>
        <module>minos-bootstrap</module>
        <module>minos-nexus</module>
        <module>minos-cli</module>
        <module>minos-api</module>
        <module>minos-mcp</module>
        <module>minos-app</module>
    </modules>

    <properties>
        <!-- CI-friendly version: release scripts override with -Drevision=... -->
        <revision>1.3.0-SNAPSHOT</revision>

        <maven.compiler.release>24</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Local developer default. CI/release overrides this with -D...=true. -->
        <minos.postgresql.tests.required>false</minos.postgresql.tests.required>

        <scip.java.bindings.version>0.10.0</scip.java.bindings.version>
        <mcp.sdk.version>2.0.1</mcp.sdk.version>
        <!--
          Keep both Jackson generations centrally pinned. MINOS' PostgreSQL codec uses
          Jackson 2 while MCP SDK 2.0.0 brings Jackson 3 through mcp-json-jackson3.
          2.22.2 and 3.2.2 contain the 2026 security fixes required by the release gate
          (patch releases on top of the original 2.22.1/3.1.5 fix versions).
        -->
        <jackson2.version>2.22.3</jackson2.version>
        <jackson3.version>3.2.3</jackson3.version>
        <slf4j.version>2.0.20</slf4j.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <jgit.version>7.8.0.202609011348-r</jgit.version>
        <junit.version>6.1.3</junit.version>
        <jacoco.version>0.8.15</jacoco.version>
        <cyclonedx.maven.plugin.version>2.9.2</cyclonedx.maven.plugin.version>
        <maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.6.0</maven.surefire.plugin.version>
        <maven.enforcer.plugin.version>3.6.3</maven.enforcer.plugin.version>
        <maven.jar.plugin.version>3.5.1</maven.jar.plugin.version>
        <maven.shade.plugin.version>3.6.2</maven.shade.plugin.version>

        <!--
          Audit tooling (docs/quality/code-audit.md). Both tools live in opt-in profiles only
          (audit-spotbugs, audit-mutation): the default clean verify never loads them.
          spotbugs-maven-plugin 4.10.4.1 is the wrapper release built around SpotBugs 4.10.4; the engine
          version is pinned separately below so that upgrading one is a visible decision.
        -->
        <spotbugs.maven.plugin.version>4.10.4.1</spotbugs.maven.plugin.version>
        <spotbugs.version>4.10.4</spotbugs.version>
        <pitest.maven.plugin.version>1.30.0</pitest.maven.plugin.version>
        <pitest.junit5.plugin.version>1.2.3</pitest.junit5.plugin.version>
        <!--
          Defaults of the audit settings, so that a direct goal call without a profile (spotbugs:check,
          pitest-maven:mutationCoverage) resolves them like the profiles do. Override with -D.
          SpotBugs: max depth; Medium keeps medium- and high-confidence findings (Low is noise);
          failThreshold is the severity at which spotbugs:check fails.
        -->
        <spotbugs.effort>Max</spotbugs.effort>
        <spotbugs.threshold>Medium</spotbugs.threshold>
        <spotbugs.failThreshold>Medium</spotbugs.failThreshold>
        <spotbugs.maxHeap>1024</spotbugs.maxHeap>
        <spotbugs.timeout>1800000</spotbugs.timeout>
        <pit.threads>2</pit.threads>
        <pit.timeoutConstant>8000</pit.timeoutConstant>
        <pit.timeoutFactor>1.5</pit.timeoutFactor>
        <pit.mutators>DEFAULTS</pit.mutators>
        <pit.maxHeapMb>1024</pit.maxHeapMb>
        <!--
          PIT mutates every production class of the module it runs in (com.minos.*), with every test of that
          module. crossModule=true also mutates upstream reactor classes against the tests of the current module
          (much more expensive; used for the cross-module pass of docs/quality/code-audit.md).
        -->
        <pit.crossModule>false</pit.crossModule>

        <!--
          ArchUnit: test-scope library of minos-app (architecture tests over the compiled classes of every module,
          docs/quality/code-audit.md). Same version as the MORPHEUS architecture tests.
        -->
        <archunit.version>1.5.1</archunit.version>
        <!--
          OWASP Dependency-Check: opt-in profiles audit-dependency-check (shipped scopes) and
          audit-dependency-check-tests (test scope included). Same plugin version as MORPHEUS (d2-security).
          13.0.0 cannot refresh the NVD feed anonymously (upstream #8715): pass the key by environment variable
          name only, -DnvdApiKeyEnvironmentVariable=NVD_API_KEY, never by value on the command line.
          Report only: failBuildOnCVSS=11 never fails on a score; failOnError=true makes a download or analysis
          error a failed build, so an error is never read as "no vulnerability".
        -->
        <dependency-check.maven.plugin.version>13.0.0</dependency-check.maven.plugin.version>
        <dependency-check.failBuildOnCVSS>11</dependency-check.failBuildOnCVSS>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson3.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-bom</artifactId>
                <version>${mcp.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-nop</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-minos-toolchain</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion><version>[24,25)</version></requireJavaVersion>
                                <requireMavenVersion><version>[3.9,4.0)</version></requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration><release>${maven.compiler.release}</release><parameters>true</parameters></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                    <systemPropertyVariables>
                        <minos.postgresql.tests.required>${minos.postgresql.tests.required}</minos.postgresql.tests.required>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                        <configuration>
                            <!--
                              minos-app runs both Surefire and Failsafe against the same
                              execution-data file. Append keeps unit-test coverage when
                              Failsafe starts so the aggregate report measures the full
                              verify lifecycle instead of only the final integration test.
                            -->
                            <append>true</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-module-report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <!--
                  Shared configuration of the audit tools. Only the profiles below put these plugins in the
                  build; this block gives a direct goal invocation (spotbugs:check, pitest:mutationCoverage) the
                  same settings. Every value that varies between runs is a property, overridable with -D.
                -->
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs.maven.plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.github.spotbugs</groupId>
                            <artifactId>spotbugs</artifactId>
                            <version>${spotbugs.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <effort>${spotbugs.effort}</effort>
                        <threshold>${spotbugs.threshold}</threshold>
                        <failThreshold>${spotbugs.failThreshold}</failThreshold>
                        <includeTests>false</includeTests>
                        <xmlOutput>true</xmlOutput>
                        <sarifOutput>true</sarifOutput>
                        <htmlOutput>true</htmlOutput>
                        <excludeFilterFile>${maven.multiModuleProjectDirectory}/quality/spotbugs-exclude.xml</excludeFilterFile>
                        <maxHeap>${spotbugs.maxHeap}</maxHeap>
                        <timeout>${spotbugs.timeout}</timeout>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${pitest.maven.plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${pitest.junit5.plugin.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <!-- targetClasses / targetTests come from the properties of the audit-mutation profile. -->
                        <outputFormats>
                            <outputFormat>HTML</outputFormat>
                            <outputFormat>XML</outputFormat>
                        </outputFormats>
                        <timestampedReports>false</timestampedReports>
                        <crossModule>${pit.crossModule}</crossModule>
                        <threads>${pit.threads}</threads>
                        <timeoutConstant>${pit.timeoutConstant}</timeoutConstant>
                        <timeoutFactor>${pit.timeoutFactor}</timeoutFactor>
                        <mutators>
                            <mutator>${pit.mutators}</mutator>
                        </mutators>
                        <jvmArgs>
                            <jvmArg>-Xmx${pit.maxHeapMb}m</jvmArg>
                            <!--
                              pitest-maven has no workingDirectory parameter, unlike the Surefire configuration above.
                              Tests resolve repository paths from the multi-module root, so the minions get it as user.dir.
                            -->
                            <jvmArg>-Duser.dir=${maven.multiModuleProjectDirectory}</jvmArg>
                        </jvmArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
          audit-spotbugs: static bug-pattern analysis (docs/quality/code-audit.md).
          Off by default. Reports: target/spotbugsXml.xml, target/spotbugs.html, target/spotbugsSarif.json per module.
          The blocking gate is the explicit goal spotbugs:check, never part of the default lifecycle.
        -->
        <profile>
            <id>audit-spotbugs</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <executions>
                            <!-- Report only (never fails): -Paudit-spotbugs verify produces the reports next to the tests. -->
                            <execution>
                                <id>spotbugs-report</id>
                                <phase>verify</phase>
                                <goals><goal>spotbugs</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          audit-mutation: PIT mutation testing (docs/quality/code-audit.md).
          Off by default and never bound to a phase: it runs only through pitest:mutationCoverage.
          Default scope: every production class of each module (com.minos.*), with every test of the same module.
          The initial three-class scope of minos-engine (2026-10-07) is no longer the default; narrow a run without
          touching a POM: -DtargetClasses=... -DtargetTests=...
        -->
        <profile>
            <id>audit-mutation</id>
            <properties>
                <targetClasses>com.minos.*</targetClasses>
                <targetTests>com.minos.*</targetTests>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          audit-dependency-check: OWASP Dependency-Check over the dependencies that MINOS ships (compile, runtime,
          provided and system scopes of every reactor module), one aggregated report at the reactor root
          (target/dependency-check/). Off by default; run the goal explicitly:
            mvnw -Paudit-dependency-check -DnvdApiKeyEnvironmentVariable=NVD_API_KEY \
                 org.owasp:dependency-check-maven:aggregate
          Not covered by this Maven scan: Maven plugins and their dependencies (build tooling), the Gradle-built
          IntelliJ plugin (minos-intellij), Docker base images, embedded SCIP tools, Python scripts. See
          docs/quality/code-audit.md.
          OSS Index requires Sonatype credentials since 2025; it is disabled rather than left to fail silently.
        -->
        <profile>
            <id>audit-dependency-check</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check.maven.plugin.version}</version>
                        <inherited>false</inherited>
                        <configuration>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                                <format>SARIF</format>
                            </formats>
                            <prettyPrint>true</prettyPrint>
                            <failBuildOnCVSS>${dependency-check.failBuildOnCVSS}</failBuildOnCVSS>
                            <suppressionFiles>
                                <suppressionFile>${maven.multiModuleProjectDirectory}/quality/dependency-check-suppressions.xml</suppressionFile>
                            </suppressionFiles>
                            <failBuildOnUnusedSuppressionRule>true</failBuildOnUnusedSuppressionRule>
                            <failOnError>true</failOnError>
                            <skipTestScope>true</skipTestScope>
                            <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                            <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                            <outputDirectory>${maven.multiModuleProjectDirectory}/target/dependency-check</outputDirectory>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          audit-dependency-check-tests: same scan with the test scope included (JUnit, Testcontainers, ArchUnit…).
          These artifacts are never shipped but run on every machine that builds MINOS. Separate report directory
          (target/dependency-check-tests/) so that the shipped view is never mixed with the build view.
        -->
        <profile>
            <id>audit-dependency-check-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check.maven.plugin.version}</version>
                        <inherited>false</inherited>
                        <configuration>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                                <format>SARIF</format>
                            </formats>
                            <prettyPrint>true</prettyPrint>
                            <failBuildOnCVSS>${dependency-check.failBuildOnCVSS}</failBuildOnCVSS>
                            <suppressionFiles>
                                <suppressionFile>${maven.multiModuleProjectDirectory}/quality/dependency-check-suppressions.xml</suppressionFile>
                            </suppressionFiles>
                            <failBuildOnUnusedSuppressionRule>true</failBuildOnUnusedSuppressionRule>
                            <failOnError>true</failOnError>
                            <skipTestScope>false</skipTestScope>
                            <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                            <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                            <outputDirectory>${maven.multiModuleProjectDirectory}/target/dependency-check-tests</outputDirectory>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>