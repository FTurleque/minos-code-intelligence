# <image>:<tag>@sha256:<index digest>: the digest is the immutable pin, the tag is what Dependabot
# (docker ecosystem) follows to propose digest and version updates. A digest without a tag is not
# followed by a tag: it would be moved to `latest`. Enforced by scripts/quality/check-image-pins.py.
FROM eclipse-temurin:25.0.4.1_1-jre@sha256:fcd7fd7b387f94bb2ac461478a7436ad8e349924c374ea8313919624dceae636

ARG MINOS_VERSION=dev
ARG MINOS_GIT_COMMIT=unknown
ARG MINOS_BUILD_TIMESTAMP=unknown

LABEL org.opencontainers.image.title="MINOS Code Intelligence MCP" \
      org.opencontainers.image.version="${MINOS_VERSION}" \
      org.opencontainers.image.revision="${MINOS_GIT_COMMIT}" \
      org.opencontainers.image.created="${MINOS_BUILD_TIMESTAMP}" \
      org.opencontainers.image.source="https://github.com/FTurleque/minos-code-intelligence"

WORKDIR /opt/minos
COPY minos-code-intelligence-*-all.jar /opt/minos/minos.jar

ENV MINOS_HOME=/var/lib/minos

RUN chmod 0444 /opt/minos/minos.jar \
    && mkdir -p /var/lib/minos \
    && chown 10001:10001 /var/lib/minos

USER 10001:10001
ENTRYPOINT ["java", "-cp", "/opt/minos/minos.jar", "com.minos.mcp.MinosMcpServer"]
