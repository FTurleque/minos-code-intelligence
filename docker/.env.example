# MINOS Docker runtime: resource ceilings (audit S11).
#
# Every variable below is OPTIONAL: the value shown is the default compiled into
# docker/compose-mcp.prod.yaml and docker/compose-mcp.connected.yaml (x-limits-<role> blocks).
# To change one, add the line WITHOUT the leading "#" to the runtime .env
# (<install root>/runtime/.env) and recreate the service; Install/update keeps these lines.
# If a container is killed for memory, or "unable to create native thread" appears, raise the
# *_MEM_LIMIT or *_PIDS_LIMIT of the role named below. Measurements: docs/user/docker-runtime.md.
# Checked against the compose files by scripts/quality/check-compose-limits.py.

# query: minos-mcp (one JVM, about 90 MiB and 30 threads, per MCP client)
# MINOS_MCP_MEM_LIMIT=3g   # unit: bytes, written <n>k, <n>m or <n>g; swap is disabled (memswap_limit = mem_limit)
# MINOS_MCP_PIDS_LIMIT=1024   # unit: processes AND threads (each MCP client JVM is about 30; see docs/user/docker-runtime.md for the floor); must be positive
# MINOS_MCP_CPUS=0   # unit: CPUs (decimal); 0 = no ceiling; keep it at or below the host CPU count or Docker refuses to create the container

# admin: minos-admin (ephemeral)
# MINOS_ADMIN_MEM_LIMIT=2g   # unit: bytes, written <n>k, <n>m or <n>g; swap is disabled (memswap_limit = mem_limit)
# MINOS_ADMIN_PIDS_LIMIT=256   # unit: processes AND threads; must be positive
# MINOS_ADMIN_CPUS=0   # unit: CPUs (decimal); 0 = no ceiling; keep it at or below the host CPU count or Docker refuses to create the container

# job: one-shot jobs: minos-bootstrap, minos-data-bootstrap, minos-tools-bootstrap, minos-provider-probe, minos-ollama-bootstrap
# MINOS_JOB_MEM_LIMIT=512m   # unit: bytes, written <n>k, <n>m or <n>g; swap is disabled (memswap_limit = mem_limit)
# MINOS_JOB_PIDS_LIMIT=128   # unit: processes AND threads; must be positive
# MINOS_JOB_CPUS=0   # unit: CPUs (decimal); 0 = no ceiling; keep it at or below the host CPU count or Docker refuses to create the container

# postgres: minos-postgres (managed PostgreSQL)
# MINOS_POSTGRES_MEM_LIMIT=1g   # unit: bytes, written <n>k, <n>m or <n>g; swap is disabled (memswap_limit = mem_limit)
# MINOS_POSTGRES_PIDS_LIMIT=128   # unit: processes AND threads; must be positive
# MINOS_POSTGRES_CPUS=0   # unit: CPUs (decimal); 0 = no ceiling; keep it at or below the host CPU count or Docker refuses to create the container

# ollama: minos-ollama (sized for the default embedding model, nomic-embed-text)
# MINOS_OLLAMA_MEM_LIMIT=2g   # unit: bytes, written <n>k, <n>m or <n>g; swap is disabled (memswap_limit = mem_limit)
# MINOS_OLLAMA_PIDS_LIMIT=256   # unit: processes AND threads; must be positive
# MINOS_OLLAMA_CPUS=0   # unit: CPUs (decimal); 0 = no ceiling; keep it at or below the host CPU count or Docker refuses to create the container
