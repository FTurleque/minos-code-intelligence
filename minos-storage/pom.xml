<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.minos</groupId>
        <artifactId>minos-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>minos-storage</artifactId>
    <name>MINOS Storage</name>
    <description>
        Storage adapters of MINOS: the local backend (com.minos.storage.local) and the PostgreSQL and pgvector backend
        (com.minos.storage.postgresql), kept apart by package rules (ADR 0068 section 4).
    </description>

    <dependencies>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          The PostgreSQL backend only. Its StorageBackendProvider service is registered by the minos-app assembly, not by
          this module; the local backend never loads these classes (LocalCompositionLoadsNoPostgresqlClassTest).
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.14</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- LogCapture, WriteProtectedTree and IcaclsTestAccessControl (com.minos.testsupport); test scope adds no edge
                 (the compile edge to minos-engine already exists) -->
            <groupId>com.minos</groupId>
            <artifactId>minos-engine</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!--
                  The application-level tests over PostgreSQL live in minos-bootstrap (this adapter does not depend on
                  minos-application); they reuse the Docker / pgvector bootstrap of PostgresTestSupport through this
                  test-jar.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven.jar.plugin.version}</version>
                <executions>
                    <execution>
                        <goals><goal>test-jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -Djdk.net.URLClassPath.disableClassPathURLCheck=true</argLine>
                    <redirectTestOutputToFile>false</redirectTestOutputToFile>
                    <!-- SH-08: registers IcaclsTestAccessControl (minos-engine test-jar) as the platform access control of this
                         module's tests, which cannot see minos-runtime-local; kept out of target/test-classes so that no
                         module using a test-jar of this one finds a second implementation -->
                    <additionalClasspathElements>
                        <additionalClasspathElement>${project.basedir}/src/test/platform-access-control</additionalClasspathElement>
                    </additionalClasspathElements>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Docker Desktop exposes its Linux engine through Windows named pipes. Keep
          Windows-only connection hints isolated from Linux/macOS. Recent hosted
          Windows runners use a Docker daemon whose minimum API is 1.44, while the
          docker-java version shaded by the Testcontainers artifacts declared in this
          module (see their <version> elements above) defaults to an older API.
          Pin only the API level here; do not force a deprecated provider strategy,
          so Npipe discovery can still select the available Windows pipe.
          The socket override is the path Ryuk mounts INSIDE its Linux container, not the
          client pipe: with the Windows pipe there, Ryuk never starts, and the PostgreSQL
          container of a killed test JVM stayed behind (MINOS-AUD-H24).
        -->
        <profile>
            <id>windows-docker-desktop-testcontainers</id>
            <activation>
                <os><family>Windows</family></os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <api.version>1.44</api.version>
                            </systemPropertyVariables>
                            <environmentVariables>
                                <DOCKER_HOST>npipe:////./pipe/dockerDesktopLinuxEngine</DOCKER_HOST>
                                <TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>/var/run/docker.sock</TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>
                            </environmentVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
