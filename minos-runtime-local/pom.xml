<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.minos</groupId>
        <artifactId>minos-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>minos-runtime-local</artifactId>
    <name>MINOS Local Provider Runtime</name>
    <description>Provider-neutral local process execution and runtime management infrastructure.</description>

    <dependencies>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- MINOS-AUD-D01: UnreadableDirectory and LogCapture (com.minos.testsupport), one copy for the tests of every module; test scope adds no edge (compile edge to minos-engine already exists) -->
            <groupId>com.minos</groupId>
            <artifactId>minos-engine</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <!-- A dummy "secret" in the environment of the test JVM: the launcher tests prove that it never
                             reaches a trusted launcher (a real MINOS process may carry tokens and passwords). -->
                        <MINOS_TEST_SECRET_SENTINEL>dummy-value-that-must-never-reach-a-launcher</MINOS_TEST_SECRET_SENTINEL>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
