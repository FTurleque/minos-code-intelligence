<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.minos</groupId>
        <artifactId>minos-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>minos-cli</artifactId>
    <name>MINOS CLI</name>
    <description>Stable CLI commands and reusable local CLI execution surface.</description>

    <dependencies>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-integration-git</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-storage-local</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-provider-scip</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-runtime-local</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-nexus</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!-- MinosLauncher stays in minos-app as the composition/system entry point. -->

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>com/minos/cli/**/*.java</include>
                    </includes>
                    <excludes>
                        <exclude>com/minos/cli/MinosLauncher.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
