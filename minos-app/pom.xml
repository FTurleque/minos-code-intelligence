<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.minos</groupId>
        <artifactId>minos-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- Preserve the historical public artifact coordinate while the reactor is split. -->
    <artifactId>minos-code-intelligence</artifactId>
    <name>MINOS Code Intelligence</name>
    <description>Local-first, language-agnostic Code Intelligence Engine.</description>

    <dependencies>
        <!-- First real S2 boundary: domain is compiled and packaged by its own module. -->
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-domain</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Infrastructure only: imports must remain confined to adapter.scip. -->
        <dependency>
            <groupId>org.scip-code</groupId>
            <artifactId>scip-java-bindings</artifactId>
            <version>${scip.java.bindings.version}</version>
        </dependency>

        <!-- Official MCP Java SDK bundle: core transports + Jackson 3 binding. -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
        </dependency>

        <!-- Pure-Java Git reader used only by M12 Git intelligence. -->
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
            <version>${jgit.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
          Transitional S2 bridge: non-domain sources still use the historical source
          layout. The domain package is excluded here because minos-domain owns it.
          Later S2 commits relocate all packages into their owning modules and remove
          these external source roots. Keeping target at repository root preserves
          M14 release/install scripts during the structural migration.
        -->
        <directory>${maven.multiModuleProjectDirectory}/target</directory>
        <sourceDirectory>${maven.multiModuleProjectDirectory}/src/main/java</sourceDirectory>
        <testSourceDirectory>${maven.multiModuleProjectDirectory}/src/test/java</testSourceDirectory>
        <resources>
            <resource>
                <directory>${maven.multiModuleProjectDirectory}/src/main/resources</directory>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>${maven.multiModuleProjectDirectory}/src/test/resources</directory>
            </testResource>
        </testResources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>com/minos/domain/**/*.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
              Existing tests intentionally use repository-relative fixtures. Maven now
              executes this module from minos-app/, so preserve the historical root
              working directory until those fixtures are expressed through an explicit
              repository-root abstraction in a later refactor.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                    <systemPropertyVariables>
                        <minos.shaded.jar>${project.build.directory}/${project.build.finalName}-all.jar</minos.shaded.jar>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven.jar.plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.minos.cli.MinosLauncher</mainClass>
                        </manifest>
                        <manifestEntries>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.minos.cli.MinosLauncher</mainClass>
                                    <manifestEntries>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
