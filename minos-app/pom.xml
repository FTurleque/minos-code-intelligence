<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.minos</groupId>
        <artifactId>minos-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>minos-code-intelligence</artifactId>
    <name>MINOS Code Intelligence</name>
    <description>Composition root and distributable MINOS Code Intelligence artifact.</description>

    <dependencies>
        <dependency><groupId>com.minos</groupId><artifactId>minos-domain</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.minos</groupId><artifactId>minos-engine</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.minos</groupId><artifactId>minos-runtime-local</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.minos</groupId><artifactId>minos-storage-local</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.minos</groupId><artifactId>minos-provider-scip</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.minos</groupId><artifactId>minos-integration-git</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.minos</groupId><artifactId>minos-application</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.minos</groupId><artifactId>minos-storage-postgresql</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.minos</groupId><artifactId>minos-nexus</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.minos</groupId><artifactId>minos-cli</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.minos</groupId><artifactId>minos-api</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.minos</groupId><artifactId>minos-mcp</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-nop</artifactId></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
    </dependencies>

    <build>
        <directory>${maven.multiModuleProjectDirectory}/target</directory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <configuration><useModulePath>false</useModulePath><workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory></configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId>
                <executions><execution><id>jacoco-aggregate-report</id><phase>verify</phase><goals><goal>report-aggregate</goal></goals><configuration><includeCurrentProject>true</includeCurrentProject><outputDirectory>${maven.multiModuleProjectDirectory}/target/site/jacoco-aggregate</outputDirectory></configuration></execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>${maven.surefire.plugin.version}</version>
                <configuration><useModulePath>false</useModulePath><workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory><systemPropertyVariables><minos.shaded.jar>${project.build.directory}/${project.build.finalName}-all.jar</minos.shaded.jar></systemPropertyVariables></configuration>
                <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>${maven.jar.plugin.version}</version>
                <configuration><archive><manifest><mainClass>com.minos.cli.MinosLauncher</mainClass></manifest><manifestEntries><Implementation-Version>${project.version}</Implementation-Version></manifestEntries></archive></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>${maven.shade.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase><goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached><shadedClassifierName>all</shadedClassifierName><createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/*.DSA</exclude></excludes></filter></filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>com.minos.cli.MinosLauncher</mainClass><manifestEntries><Implementation-Version>${project.version}</Implementation-Version></manifestEntries></transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
