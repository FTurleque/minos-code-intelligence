<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.minos</groupId>
        <artifactId>minos-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- Preserve the historical public artifact coordinate while the reactor is split. -->
    <artifactId>minos-code-intelligence</artifactId>
    <name>MINOS Code Intelligence</name>
    <description>Local-first, language-agnostic Code Intelligence Engine.</description>

    <dependencies>
        <!-- S2 boundaries compiled and packaged independently. -->
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-runtime-local</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-storage-local</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-provider-scip</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.minos</groupId>
            <artifactId>minos-integration-git</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Official MCP Java SDK bundle: core transports + Jackson 3 binding. -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
          Transitional S2 bridge: sources still use the historical source layout, but
          Maven ownership is explicit. Extracted modules are excluded here and supplied
          through reactor dependencies. Later S2 commits physically relocate sources and
          remove these external roots. Keeping target at repository root preserves M14
          release/install scripts.
        -->
        <directory>${maven.multiModuleProjectDirectory}/target</directory>
        <sourceDirectory>${maven.multiModuleProjectDirectory}/src/main/java</sourceDirectory>
        <testSourceDirectory>${maven.multiModuleProjectDirectory}/src/test/java</testSourceDirectory>
        <resources>
            <resource>
                <directory>${maven.multiModuleProjectDirectory}/src/main/resources</directory>
                <excludes>
                    <exclude>com/minos/adapter/scip/runtime/**</exclude>
                </excludes>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>${maven.multiModuleProjectDirectory}/src/test/resources</directory>
            </testResource>
        </testResources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>com/minos/domain/**/*.java</exclude>
                        <exclude>com/minos/query/**/*.java</exclude>
                        <exclude>com/minos/store/**/*.java</exclude>
                        <exclude>com/minos/git/**/*.java</exclude>
                        <exclude>com/minos/adapter/scip/**/*.java</exclude>
                        <exclude>com/minos/discovery/ProjectDiscovery.java</exclude>
                        <exclude>com/minos/orchestration/IndexerCapability.java</exclude>
                        <exclude>com/minos/orchestration/IndexerQualification.java</exclude>
                        <exclude>com/minos/orchestration/IndexerDescriptor.java</exclude>
                        <exclude>com/minos/orchestration/IndexingRequirements.java</exclude>
                        <exclude>com/minos/orchestration/IndexerNegotiationResult.java</exclude>
                        <exclude>com/minos/orchestration/IndexerRegistry.java</exclude>
                        <exclude>com/minos/orchestration/IndexingMode.java</exclude>
                        <exclude>com/minos/orchestration/IndexingRuntimePorts.java</exclude>
                        <exclude>com/minos/runtime/CommandLocator.java</exclude>
                        <exclude>com/minos/runtime/IndexerProcessPlan.java</exclude>
                        <exclude>com/minos/runtime/IndexerProcessPlanFactory.java</exclude>
                        <exclude>com/minos/runtime/ProcessIndexerExecutor.java</exclude>
                        <exclude>com/minos/runtime/ProviderRuntimeManager.java</exclude>
                        <exclude>com/minos/runtime/ProviderRuntimeStatus.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Preserve the historical repository root for fixture-relative tests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                    <systemPropertyVariables>
                        <minos.shaded.jar>${project.build.directory}/${project.build.finalName}-all.jar</minos.shaded.jar>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven.jar.plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.minos.cli.MinosLauncher</mainClass>
                        </manifest>
                        <manifestEntries>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.minos.cli.MinosLauncher</mainClass>
                                    <manifestEntries>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
